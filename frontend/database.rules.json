{
  "rules": {
    "analyses": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$analysisId": {
          ".validate": "newData.hasChildren(['userId', 'image', 'createdAt']) && newData.child('userId').val() == auth.uid"
        }
      }
    }
  }
}